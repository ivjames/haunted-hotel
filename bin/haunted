#!/usr/bin/env bash
# haunted — operate haunted.lab980.com (the Haunted Hotel game).
#
# A fully static site: one index.html, no build, no app process, no port,
# no pm2. provision-site doesn't fit (its vhost is proxy-shaped), so this
# CLI does the whole bring-up with the same doctl/security-headers/certbot
# shape as the rest of the droplet. Modeled on sparkle-butt's bin/sparkle.
#
#   haunted setup     # DNS A record + static nginx vhost + TLS (idempotent)
#   haunted deploy    # fetch + hard-reset to origin/main, nothing else
#   haunted status    # quick local health: vhost, cert, git, public probe
#   haunted remove    # tear down vhost + cert + DNS (repo dir left in place)
set -euo pipefail

DOMAIN="lab980.com"
STUB="haunted"
FQDN="$STUB.$DOMAIN"
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CONF="/etc/nginx/sites-available/$FQDN"
SNIPPET="/etc/nginx/snippets/lab980-security-headers.conf"

c_blue=$'\033[1;34m'; c_yellow=$'\033[1;33m'; c_red=$'\033[1;31m'; c_off=$'\033[0m'
log()  { printf '%s==>%s %s\n' "$c_blue" "$c_off" "$*"; }
warn() { printf '%swarn:%s %s\n' "$c_yellow" "$c_off" "$*" >&2; }
die()  { printf '%serror:%s %s\n' "$c_red" "$c_off" "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
haunted — operate haunted.lab980.com (static HTML5 canvas game).

Usage:
  haunted setup [--no-dns] [--no-tls] [--ip IP]
  haunted deploy
  haunted status
  haunted remove [--yes]

setup is idempotent: it creates the DigitalOcean A record (via doctl), a
static nginx vhost rooted at this repo's checkout, and a certbot cert with
the 80->443 redirect. deploy is fetch + reset to origin/main — the site is
one static index.html, so that IS the deploy.
USAGE
}

need_root() { [ "$(id -u)" -eq 0 ] || die "run as root."; }

droplet_ip() {
  curl -s --max-time 5 http://169.254.169.254/metadata/v1/interfaces/public/0/ipv4/address || true
}

resolve() {
  if command -v dig >/dev/null; then dig +short "$1" | tail -1
  else getent hosts "$1" | awk '{print $1}' | head -1; fi
}

cmd_setup() {
  need_root
  local DO_DNS=1 DO_TLS=1 IP=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-dns) DO_DNS=0; shift;;
      --no-tls) DO_TLS=0; shift;;
      --ip)     IP="$2"; shift 2;;
      *) die "unknown option: $1";;
    esac
  done
  [ -f "$DIR/index.html" ] || die "no index.html in $DIR — is this the repo checkout?"
  log "Setting up $FQDN  (root: $DIR)"

  if [ -z "$IP" ]; then IP="$(droplet_ip)"; fi

  # ---- DNS ----
  if [ "$DO_DNS" -eq 1 ]; then
    command -v doctl >/dev/null || die "doctl not found (or pass --no-dns)."
    [ -n "$IP" ] || die "couldn't determine droplet IP; pass --ip."
    local existing
    existing="$(doctl compute domain records list "$DOMAIN" --no-header --format Type,Name,Data 2>/dev/null \
                | awk -v n="$STUB" '$1=="A" && $2==n {print $3}' | head -1)"
    if [ -n "$existing" ]; then
      log "DNS: A $FQDN -> $existing already exists (leaving as-is)"
    else
      log "DNS: creating A $FQDN -> $IP (ttl 300)"
      doctl compute domain records create "$DOMAIN" \
        --record-type A --record-name "$STUB" --record-data "$IP" --record-ttl 300 >/dev/null
    fi
  fi

  # ---- shared security headers snippet (fix-security-headers owns content) ----
  if [ ! -f "$SNIPPET" ]; then
    mkdir -p /etc/nginx/snippets
    cat > "$SNIPPET" <<'EOF'
# lab980 shared security headers — managed by fix-security-headers.
# Included at server{} level by every :443 vhost. Do not add a CSP here:
# that one is per-site (snippets/lab980-csp-self.conf, opt-in).
add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "SAMEORIGIN" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
EOF
    log "nginx: seeded $SNIPPET"
  fi

  # ---- static vhost ----
  if [ -f "$CONF" ]; then
    log "nginx: $CONF already exists (leaving as-is)"
  else
    log "nginx: writing $CONF (static root -> $DIR)"
    cat > "$CONF" <<EOF
server {
    listen 80;
    listen [::]:80;
    server_name $FQDN;

    include snippets/lab980-security-headers.conf;

    root $DIR;
    index index.html;

    location / {
        try_files \$uri \$uri/ =404;
    }

    location ~ /\.(git|env) {
        deny all;
    }
}
EOF
  fi
  ln -sf "$CONF" "/etc/nginx/sites-enabled/$FQDN"
  nginx -t && systemctl reload nginx
  log "nginx: enabled and reloaded"

  # ---- TLS ----
  if [ "$DO_TLS" -eq 1 ]; then
    if ! command -v certbot >/dev/null; then
      warn "certbot not found; skipping TLS. Later: certbot --nginx -d $FQDN --redirect -n"
    else
      local ok=0
      if [ -z "$IP" ]; then
        warn "droplet IP unknown; skipping DNS wait and attempting certbot directly."
        ok=1
      else
        log "waiting for $FQDN to resolve to $IP (up to ~5 min) ..."
        for _ in $(seq 1 30); do
          [ "$(resolve "$FQDN")" = "$IP" ] && { ok=1; break; }
          sleep 10
        done
      fi
      if [ "$ok" -eq 1 ]; then
        log "TLS: issuing cert for $FQDN"
        certbot --nginx -d "$FQDN" --redirect -n
      else
        warn "$FQDN not resolving to $IP yet (DNS still propagating)."
        warn "Re-run TLS later:  certbot --nginx -d $FQDN --redirect -n"
      fi
    fi
  fi

  log "Done. The hotel is open: https://$FQDN/"
}

cmd_deploy() {
  [ -e "$DIR/.git" ] || die "$DIR is not a git checkout."
  log "deploy: fetch + reset to origin/main in $DIR"
  git -C "$DIR" fetch origin main
  git -C "$DIR" reset --hard origin/main
  log "deployed $(git -C "$DIR" rev-parse --short HEAD) — static site, nothing to restart"
}

cmd_status() {
  local fail=0
  if [ -L "/etc/nginx/sites-enabled/$FQDN" ]; then log "vhost: enabled"; else warn "vhost: NOT enabled"; fail=1; fi
  if [ -d "/etc/letsencrypt/live/$FQDN" ]; then
    local exp
    exp="$(openssl x509 -enddate -noout -in "/etc/letsencrypt/live/$FQDN/cert.pem" 2>/dev/null | cut -d= -f2 || true)"
    log "cert: present${exp:+ (expires $exp)}"
  else
    warn "cert: none (run: haunted setup, or certbot --nginx -d $FQDN --redirect -n)"
  fi
  if [ -e "$DIR/.git" ]; then
    log "git:  $(git -C "$DIR" rev-parse --short HEAD) on $(git -C "$DIR" rev-parse --abbrev-ref HEAD)"
  fi
  local code
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://$FQDN/" || true)"
  if [ "$code" = "200" ]; then log "public: https://$FQDN/ -> 200"
  else warn "public: https://$FQDN/ -> ${code:-no answer}"; fail=1; fi
  exit "$fail"
}

cmd_remove() {
  need_root
  local yes=0
  [ "${1:-}" = "--yes" ] && yes=1
  if [ "$yes" -ne 1 ]; then
    printf 'Tear down %s (vhost + cert + DNS; repo dir stays)? [y/N] ' "$FQDN"
    read -r a; case "$a" in y|Y) ;; *) die "aborted.";; esac
  fi
  rm -f "/etc/nginx/sites-enabled/$FQDN" "$CONF"
  nginx -t && systemctl reload nginx || true
  log "nginx: vhost removed"
  if command -v certbot >/dev/null && [ -d "/etc/letsencrypt/live/$FQDN" ]; then
    certbot delete --cert-name "$FQDN" -n || warn "certbot delete failed; remove manually."
    log "TLS: cert deleted"
  fi
  if command -v doctl >/dev/null; then
    local ids
    ids="$(doctl compute domain records list "$DOMAIN" --no-header --format ID,Type,Name 2>/dev/null \
           | awk -v n="$STUB" '$2=="A" && $3==n {print $1}')"
    for id in $ids; do
      doctl compute domain records delete "$DOMAIN" "$id" -f && log "DNS: record $id deleted"
    done
  fi
  log "Removed $FQDN. Repo dir left at $DIR."
}

case "${1:-}" in
  setup)  shift; cmd_setup "$@";;
  deploy) shift; cmd_deploy "$@";;
  status) shift; cmd_status "$@";;
  remove) shift; cmd_remove "$@";;
  -h|--help|help|"") usage;;
  *) die "unknown command: $1 (see --help)";;
esac
